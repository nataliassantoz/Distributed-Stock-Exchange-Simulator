meta {
  name: Cadastro invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/cadastro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "nome": "M",
    "email": "invalido",
    "senha": "123"
  }
}

tests {
  test("Dados invalidos retornam 400", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().erros).to.have.property("nome");
    expect(res.getBody().erros).to.have.property("email");
    expect(res.getBody().erros).to.have.property("senha");
  });
}
