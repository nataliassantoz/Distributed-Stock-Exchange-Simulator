meta {
  name: Cadastrar usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/cadastro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "nome": "{{nome}}",
    "email": "{{email}}",
    "senha": "{{senha}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("usuarioId", res.getBody().id);
  }
}

tests {
  test("Usuario criado com identificador unico", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number").and.above(0);
    expect(res.getBody().email).to.equal(bru.getVar("email"));
    expect(res.getBody()).to.not.have.property("senha");
    expect(res.getBody()).to.not.have.property("senhaHash");
  });
}
