meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

body:json {
  {
    "email": "natalias@gmail.com",
    "senha": "12345678t"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("idSessao", res.getBody().idSessao);
  }
}

tests {
  test("Sessao criada para o usuario cadastrado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().idSessao).to.be.a("string").and.not.empty;
    expect(res.getBody().usuario.id).to.equal(bru.getVar("usuarioId"));
    expect(res.getBody().usuario).to.not.have.property("senhaHash");
  });
}
